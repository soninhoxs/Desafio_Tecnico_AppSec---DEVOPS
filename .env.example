# Copie para .env (ou rode: python scripts/bootstrap_env.py, que gera valores aleatórios).
# NUNCA commite o .env (está no .gitignore).

# Superusuário do PostgreSQL (só usado para criar o banco/usuário da app)
POSTGRES_PASSWORD=
# Usuário "coursesphere" (sem privilégios de superusuário) usado pela API
APP_DB_PASSWORD=
# Chave mestra do Rails (a chave dos JWT é derivada dela). 64+ bytes aleatórios.
SECRET_KEY_BASE=
# Token que o Prometheus usa para ler /metrics
METRICS_TOKEN=
# Senha do admin do Grafana
GRAFANA_ADMIN_PASSWORD=

# Dados de demonstração (cursos/aulas de exemplo). Só para laboratório.
ALLOW_DEMO_SEED=true
# Senha dos usuários tech@ e design@coursesphere.com do seed de demo
DEMO_USER_PASSWORD=

# Versão/tag das imagens
APP_VERSION=local
